{
  "name": "choice-train-browser-tests",
  "private": true,
  "description": "Playwright regression and visual smoke tests for ChoiceTrain for ShowMe.",
  "scripts": {
    "test:release": "node --test scripts/stamp-build.test.js",
    "test:promotion": "node --test scripts/check-v180-promotion.test.js && node scripts/check-v180-promotion.js --structure-check",
    "test:schema": "node --test scripts/schema-contract.test.js",
    "test:coverage": "node --test scripts/check-v180-coverage.test.js && node scripts/check-v180-coverage.js",
    "check:candidate:v180": "node scripts/check-v180-candidate.js",
    "check:promotion:v180": "node scripts/check-v180-promotion.js",
    "test:browser": "node scripts/run-browser-tests.js",
    "test:browser:compat": "node scripts/run-browser-tests.js --config playwright.compat.config.js",
    "test:browser:headed": "node scripts/run-browser-tests.js --headed",
    "test:browser:ui": "node scripts/run-browser-tests.js --ui",
    "audit:visual:v170": "node scripts/capture-v170-visual-audit.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1"
  }
}
