{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dioncroft.github.io/choice_train/schemas/choice-train-model-dataset-v1.schema.json",
  "title": "ChoiceTrain privacy-minimised model-development dataset core contract v1",
  "type": "object",
  "required": ["app", "export_schema_version", "purpose", "privacy_status", "governance", "privacy_manifest", "participant_count", "session_count", "sessions", "teacher_decisions", "interpretation_boundary"],
  "properties": {
    "app": { "const": "ChoiceTrain for ShowMe" },
    "export_schema_version": { "const": "1.1.0" },
    "purpose": { "type": "string", "minLength": 1 },
    "privacy_status": { "const": "pseudonymised-not-anonymous" },
    "governance": {
      "type": "object",
      "required": ["human_review_required", "automated_decision_making_enabled", "model_training_performed_by_application"],
      "properties": {
        "human_review_required": { "const": true },
        "automated_decision_making_enabled": { "const": false },
        "model_training_performed_by_application": { "const": false }
      },
      "additionalProperties": true
    },
    "privacy_manifest": {
      "type": "object",
      "required": ["names_included", "aliases_included", "free_text_included", "image_data_included", "photo_labels_included", "exact_timestamps_included", "raw_touch_coordinates_included", "prompt_wording_included", "source_session_ids_included", "recommendation_ids_included", "recommendation_review_ids_included", "external_transmission"],
      "properties": {
        "names_included": { "const": false },
        "aliases_included": { "const": false },
        "free_text_included": { "const": false },
        "image_data_included": { "const": false },
        "photo_labels_included": { "const": false },
        "exact_timestamps_included": { "const": false },
        "raw_touch_coordinates_included": { "const": false },
        "prompt_wording_included": { "const": false },
        "source_session_ids_included": { "const": false },
        "recommendation_ids_included": { "const": false },
        "recommendation_review_ids_included": { "const": false },
        "external_transmission": { "const": false }
      },
      "additionalProperties": true
    },
    "participant_count": { "type": "integer", "minimum": 0 },
    "session_count": { "type": "integer", "minimum": 0 },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["eeg_marker_diagnostics", "retention_planning"],
        "properties": {
          "eeg_marker_diagnostics": { "$ref": "#/$defs/privacySafeMarkerDiagnostics" },
          "retention_planning": {
            "oneOf": [
              { "$ref": "#/$defs/privacySafeRetentionPlanning" },
              { "type": "null" }
            ]
          },
          "recommendation_application": {
            "oneOf": [
              { "$ref": "#/$defs/privacySafeRecommendationApplication" },
              { "type": "null" }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "teacher_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/privacySafeTeacherDecision" }
    },
    "interpretation_boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "privacySafeRetentionPlanning": {
      "type": "object",
      "required": ["version", "configured_gap_days", "minimum_scored_opportunities_per_observation"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "configured_gap_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "minimum_scored_opportunities_per_observation": { "const": 3 }
      },
      "additionalProperties": false
    },
    "privacySafeMarkerDiagnostics": {
      "type": "object",
      "required": ["version", "ordered_trials", "expected_order_trials", "ordering_pct", "response_timing_comparisons", "timing_difference_count", "response_timing_tolerance_ms", "non_monotonic_marker_count", "duplicate_marker_id_count", "protocol_fields_complete", "protocol_fields_expected", "protocol_completeness_pct", "declared_sync_method", "hardware_synchronization_verified", "interpretation_boundary"],
      "properties": {
        "version": { "type": "string" },
        "ordered_trials": { "type": "integer", "minimum": 0 },
        "expected_order_trials": { "type": "integer", "minimum": 0 },
        "ordering_pct": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "response_timing_comparisons": { "type": "integer", "minimum": 0 },
        "timing_difference_count": { "type": "integer", "minimum": 0 },
        "response_timing_tolerance_ms": { "type": "number", "minimum": 0 },
        "non_monotonic_marker_count": { "type": "integer", "minimum": 0 },
        "duplicate_marker_id_count": { "type": "integer", "minimum": 0 },
        "protocol_fields_complete": { "type": "integer", "minimum": 0 },
        "protocol_fields_expected": { "type": "integer", "minimum": 0 },
        "protocol_completeness_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "declared_sync_method": { "type": "string" },
        "hardware_synchronization_verified": { "const": false },
        "interpretation_boundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "privacySafeTeacherDecision": {
      "type": "object",
      "required": ["participant_code", "decision_index", "recommendation_version", "decision", "applied_session_count", "proposal", "final_plan"],
      "properties": {
        "participant_code": { "type": "string", "minLength": 1 },
        "decision_index": { "type": "integer", "minimum": 1 },
        "recommendation_version": { "type": ["string", "null"] },
        "decision": {
          "oneOf": [
            { "enum": ["approved", "adjusted", "declined", "deferred"] },
            { "type": "null" }
          ]
        },
        "applied_session_count": { "type": "integer", "minimum": 0 },
        "proposal": {
          "oneOf": [
            { "$ref": "#/$defs/privacySafeRecommendationProposal" },
            { "type": "null" }
          ]
        },
        "final_plan": {
          "oneOf": [
            { "$ref": "#/$defs/privacySafeFinalPlan" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "privacySafeRecommendationProposal": {
      "type": "object",
      "required": ["action", "skill_id", "recommended_task_kind", "recommended_level", "support_direction", "rationale_codes"],
      "properties": {
        "action": { "type": ["string", "null"] },
        "skill_id": { "type": ["string", "null"] },
        "recommended_task_kind": { "type": ["string", "null"] },
        "recommended_level": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
        "support_direction": { "type": ["string", "null"] },
        "rationale_codes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "privacySafeFinalPlan": {
      "type": "object",
      "required": ["task_kind", "level", "support_direction"],
      "properties": {
        "task_kind": { "type": ["string", "null"] },
        "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
        "support_direction": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "privacySafeRecommendationApplication": {
      "type": "object",
      "required": ["applied", "application_schema_version", "recommendation_version", "review_decision", "planned_task_kind", "planned_level", "support_direction", "plan_matches_session_settings"],
      "properties": {
        "applied": { "const": true },
        "application_schema_version": { "type": ["string", "null"] },
        "recommendation_version": { "type": ["string", "null"] },
        "review_decision": {
          "oneOf": [
            { "enum": ["approved", "adjusted"] },
            { "type": "null" }
          ]
        },
        "planned_task_kind": { "type": ["string", "null"] },
        "planned_level": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
        "support_direction": { "type": ["string", "null"] },
        "plan_matches_session_settings": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
