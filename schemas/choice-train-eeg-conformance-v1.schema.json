{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dioncroft.github.io/choice_train/schemas/choice-train-eeg-conformance-v1.schema.json",
  "title": "ChoiceTrain pupil-free EEG marker conformance fixture 1.0.0",
  "description": "A deterministic marker catalogue for parser and event-code compatibility checks. It does not implement transport or validate timing, hardware synchronisation, EEG acquisition, or signal quality.",
  "type": "object",
  "required": [
    "fixture_schema_version",
    "fixture_id",
    "purpose",
    "synthetic_data",
    "contains_pupil_data",
    "external_transmission",
    "transport_implemented",
    "timing_validation_performed",
    "hardware_synchronization_verified",
    "timing_basis",
    "build",
    "marker_code_map",
    "markers",
    "required_external_checks"
  ],
  "properties": {
    "fixture_schema_version": { "const": "1.0.0" },
    "fixture_id": { "const": "choice-train-eeg-marker-conformance-v1" },
    "purpose": { "type": "string", "minLength": 1 },
    "synthetic_data": { "const": true },
    "contains_pupil_data": { "const": false },
    "external_transmission": { "const": false },
    "transport_implemented": { "const": false },
    "timing_validation_performed": { "const": false },
    "hardware_synchronization_verified": { "const": false },
    "timing_basis": { "type": "string", "minLength": 1 },
    "build": {
      "type": "object",
      "required": ["app", "version", "channel", "based_on_commit"],
      "properties": {
        "app": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "based_on_commit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "marker_code_map": {
      "type": "object",
      "required": [
        "session_start", "prompt_onset", "cue_onset", "stimulus_onset", "target_present", "no_go",
        "question_answer_blank_onset", "question_answer_blank_offset", "response", "omission", "commission",
        "feedback_onset", "prompt_onset_support", "audio_onset", "reward_onset", "break_onset", "break_offset",
        "artifact", "session_complete"
      ],
      "properties": {
        "session_start": { "const": 1 },
        "prompt_onset": { "const": 10 },
        "cue_onset": { "const": 11 },
        "stimulus_onset": { "const": 12 },
        "target_present": { "const": 13 },
        "no_go": { "const": 14 },
        "question_answer_blank_onset": { "const": 15 },
        "question_answer_blank_offset": { "const": 16 },
        "response": { "const": 20 },
        "omission": { "const": 21 },
        "commission": { "const": 22 },
        "feedback_onset": { "const": 30 },
        "prompt_onset_support": { "const": 31 },
        "audio_onset": { "const": 32 },
        "reward_onset": { "const": 33 },
        "break_onset": { "const": 40 },
        "break_offset": { "const": 41 },
        "artifact": { "const": 50 },
        "session_complete": { "const": 90 }
      },
      "additionalProperties": false
    },
    "markers": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "required": ["marker_id", "sequence_index", "scenario_group", "code", "name", "t_rel_ms"],
        "properties": {
          "marker_id": { "type": "string", "pattern": "^fixture-\\d{3}$" },
          "sequence_index": { "type": "integer", "minimum": 1, "maximum": 19 },
          "scenario_group": { "enum": ["session-boundary", "prompting", "question-answer-blank", "stimulus", "outcome", "feedback", "break", "artifact"] },
          "code": { "enum": [1, 10, 11, 12, 13, 14, 15, 16, 20, 21, 22, 30, 31, 32, 33, 40, 41, 50, 90] },
          "name": { "enum": ["session_start", "prompt_onset", "cue_onset", "stimulus_onset", "target_present", "no_go", "question_answer_blank_onset", "question_answer_blank_offset", "response", "omission", "commission", "feedback_onset", "prompt_onset_support", "audio_onset", "reward_onset", "break_onset", "break_offset", "artifact", "session_complete"] },
          "t_rel_ms": { "type": "integer", "minimum": 0, "maximum": 1800, "multipleOf": 100 }
        },
        "additionalProperties": false
      }
    },
    "required_external_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
