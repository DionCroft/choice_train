{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dioncroft.github.io/choice_train/schemas/choice-train-trial-v8.schema.json",
  "title": "ChoiceTrain trial core contract v8",
  "description": "Core interoperable fields for one ChoiceTrain V1.8 trial. Optional audit fields remain documented in DATA_DICTIONARY.md.",
  "type": "object",
  "required": ["trial_id", "session_id", "schema_version", "skill_graph_version", "skill_ids", "generator_version", "task_family", "task_kind", "level", "question_index", "correct", "omission", "commission", "prompt_wording", "option_metadata", "student_friendly_mode"],
  "properties": {
    "trial_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 8 },
    "skill_graph_version": { "const": "1.4.0" },
    "generator_version": { "const": "1.6.0" },
    "recommendation_id": { "type": ["string", "null"] },
    "recommendation_review_id": { "type": ["string", "null"] },
    "recommendation_version": { "type": ["string", "null"] },
    "recommendation_review_decision": {
      "oneOf": [
        { "enum": ["approved", "adjusted"] },
        { "type": "null" }
      ]
    },
    "recommendation_application_status": {
      "oneOf": [
        { "const": "applied-as-reviewed" },
        { "type": "null" }
      ]
    },
    "skill_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["access.touch_screen", "access.touch_target", "access.track_target", "recognition.named_object", "discrimination.named_object", "categorisation.category_member", "categorisation.match_category", "categorisation.complete_group", "categorisation.category_exclusion", "categorisation.declared_colour", "choice.preference", "attention.sustained", "attention.selective_spatial", "attention.orienting", "attention.executive"]
      }
    },
    "task_family": { "enum": ["foundation", "cpat"] },
    "task_kind": {
      "enum": ["touch-screen", "touch-object", "moving-target", "find-object", "discriminate-object", "find-category", "match-category", "complete-category-group", "category-exclusion", "find-attribute", "choice-preference", "cpat-suite", "cpat-sustained", "cpat-selective", "cpat-orienting", "cpat-executive"]
    },
    "level": { "type": "integer", "minimum": 1, "maximum": 10 },
    "question_index": { "type": "integer", "minimum": 1 },
    "attempt_index": { "type": "integer", "minimum": 1 },
    "response_time_ms": { "type": ["number", "null"], "minimum": 0 },
    "correct": { "type": "boolean" },
    "omission": { "type": "boolean" },
    "commission": { "type": "boolean" },
    "correct_rejection": { "type": "boolean" },
    "prompt_wording": { "type": "string" },
    "option_metadata": { "type": "array", "items": { "type": "object" } },
    "cue_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "reference_category": { "type": "string" },
    "category_relation": { "type": "string" },
    "target_attribute_key": { "type": "string" },
    "target_attribute_value": { "type": "string" },
    "attribute_source": { "type": "string" },
    "attribute_relation": { "type": "string" },
    "support_code": { "type": "string" },
    "independence_status": { "type": "string" },
    "student_friendly_mode": { "type": "boolean" }
  },
  "additionalProperties": true
}
